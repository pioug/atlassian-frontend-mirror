{
	"name": "@atlaskit/frontend-utilities",
	"version": "4.5.0",
	"description": "Collecton of small useful frontend utilities",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Frontend Platform Consortium",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "FrontendUtilities"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"devDependencies": {
		"@atlassian/a11y-jest-testing": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"typescript": "root:*",
		"wait-for-expect": "root:*"
	},
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./convert-to-error/main": "./src/error-handling/convert-to-error/main.ts",
		"./convert-to-error": "./src/error-handling/convert-to-error/main.ts",
		"./convertToError": "./src/error-handling/convert-to-error/convertToError.ts",
		"./hooks/use-interval": "./src/hooks/use-interval/index.ts",
		"./hooks/use-local-storage": "./src/hooks/use-local-storage/index.ts",
		"./hooks/use-previous": "./src/hooks/use-previous/index.ts",
		"./hooks/use-why-did-update": "./src/hooks/use-why-did-update/index.tsx",
		"./hooks": "./src/hooks/index.ts",
		"./local-storage/main": "./src/storage/local-storage/main.ts",
		"./local-storage": "./src/storage/local-storage/main.ts",
		"./retry-operation/constants": "./src/network/retry-operation/constants.ts",
		"./retry-operation/FailedFetchError": "./src/network/retry-operation/errors/FailedFetchError.ts",
		"./retry-operation/main": "./src/network/retry-operation/main.ts",
		"./retry-operation/retry-on-exception": "./src/network/retry-operation/retry-on-exception.ts",
		"./retry-operation/types": "./src/network/retry-operation/types.ts",
		"./retry-operation/wait": "./src/network/retry-operation/wait.ts",
		"./retry-operation": "./src/network/retry-operation/index.ts",
		"./simple-hash": "./src/utils/simple-hash/index.ts",
		"./storage-client/constants": "./src/storage/storage-client/constants.ts",
		"./storage-client/main": "./src/storage/storage-client/main.ts",
		"./storage-client/types": "./src/storage/storage-client/types.ts",
		"./storage-client": "./src/storage/storage-client/main.ts",
		"./StorageClient": "./src/storage/storage-client/StorageClient.ts",
		"./use-interval": "./src/hooks/use-interval/index.ts",
		"./use-previous": "./src/hooks/use-previous/index.ts",
		"./use-why-did-update": "./src/hooks/use-why-did-update/index.tsx",
		"./useInterval": "./src/hooks/use-interval/useInterval.ts",
		"./useLocalStorage": "./src/hooks/use-local-storage/useLocalStorage.ts",
		"./useLocalStorageRecord": "./src/hooks/use-local-storage/useLocalStorageRecord.ts",
		"./usePrevious": "./src/hooks/use-previous/usePrevious.ts",
		"./useWhyDidUpdate": "./src/hooks/use-why-did-update/useWhyDidUpdate.tsx",
		"./useWhyDidUpdateShallow": "./src/hooks/use-why-did-update/useWhyDidUpdateShallow.tsx"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"lodash": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	}
}
