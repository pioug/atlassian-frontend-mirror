{
	"name": "@atlaskit/top-layer",
	"version": "6.0.0",
	"description": "Low-level layering primitives based on popover and dialog",
	"homepage": "https://atlassian.design/components/top-layer",
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Top Layer",
			"category": "Libraries"
		},
		"integrationTests": {
			"additionalBrowsers": [
				"desktop-firefox",
				"desktop-webkit"
			]
		}
	},
	"exports": {
		".": "./src/index.tsx",
		"./create-close-event": "./src/dialog/create-close-event.tsx",
		"./dialog-content": "./src/dialog/dialog-content.tsx",
		"./dialog-scroll-lock": "./src/dialog-scroll-lock/index.tsx",
		"./dialog/types": "./src/dialog/types.tsx",
		"./get-aria-for-trigger": "./src/internal/get-aria-for-trigger.tsx",
		"./get-first-focusable": "./src/focus/get-first-focusable.tsx",
		"./get-last-focusable": "./src/focus/get-last-focusable.tsx",
		"./get-next-focusable": "./src/focus/get-next-focusable.tsx",
		"./is-at-current-menu-level": "./src/use-arrow-navigation/is-at-current-menu-level.tsx",
		"./legacy-placements": "./src/placement-map/legacy-placements.tsx",
		"./placement-map/index": "./src/placement-map/index.tsx",
		"./popover/types": "./src/popover/types.tsx",
		"./popover-surface": "./src/popover-surface/popover-surface.tsx",
		"./popover/create-close-event": "./src/popover/create-close-event.tsx",
		"./popover/popover": "./src/popover/popover.tsx",
		"./resolve-placement": "./src/internal/resolve-placement.tsx",
		"./testing/polyfill": "./src/testing/polyfill.tsx",
		"./testing/to-be-visible": "./src/testing/to-be-visible.tsx",
		"./types": "./src/focus/types.tsx",
		"./use-anchored-popover": "./src/internal/use-anchored-popover.tsx",
		"./use-anchored-popover-at-point": "./src/internal/use-anchored-popover-at-point.tsx",
		"./use-arrow-navigation/use-arrow-navigation": "./src/use-arrow-navigation/use-arrow-navigation.tsx",
		"./use-popover-id": "./src/entry-points/use-popover-id.tsx",
		"./use-simple-light-dismiss": "./src/use-simple-light-dismiss/index.tsx",
		"./dialog": "./src/dialog/index.tsx",
		"./placement-map": "./src/entry-points/placement-map.tsx",
		"./popover": "./src/popover/index.tsx",
		"./use-arrow-navigation": "./src/entry-points/use-arrow-navigation.tsx"
	},
	"dependencies": {
		"@atlaskit/browser-apis": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/ds-lib": "workspace:^",
		"@atlaskit/layering": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"bind-event-listener": "root:*",
		"raf-schd": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/checkbox": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/lozenge": "workspace:^",
		"@atlaskit/pragmatic-drag-and-drop": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/select": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@atlaskit/textfield": "workspace:^",
		"@atlaskit/toggle": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/jest-dom": "root:*",
		"@types/raf-schd": "root:*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tiny-invariant": "root:*"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	}
}
