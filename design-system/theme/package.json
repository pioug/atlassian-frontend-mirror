{
	"name": "@atlaskit/theme",
	"version": "28.2.3",
	"description": "Theme contains solutions for global theming, colors, and other useful mixins.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Theme",
			"category": "Libraries"
		}
	},
	"dependencies": {
		"@atlaskit/ds-lib": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/visual-regression": "workspace:^",
		"@atlaskit/datetime-picker": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@compiled/react": "root:*",
		"@testing-library/react": "root:*",
		"@types/color": "root:*",
		"color": "root:*",
		"jest-in-case": "root:*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"keywords": [
		"atlaskit",
		"css",
		"theme",
		"react",
		"ui"
	],
	"exports": {
		".": "./src/index.tsx",
		"./components": "./src/components.tsx",
		"./constants": "./src/constants.tsx",
		"./create-theme": "./src/utils/create-theme.tsx",
		"./get-theme": "./src/utils/get-theme.tsx",
		"./theme": "./src/components/theme.tsx",
		"./types": "./src/types.tsx"
	},
	"homepage": "https://atlaskit.atlassian.com/packages/design-system/eslint-plugin"
}
