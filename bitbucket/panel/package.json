{
	"name": "@atlaskit/panel",
	"version": "2.15.0",
	"description": "A React component rendering a collapsible panel",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": "./src/index.ts",
		"./i18n/*": {
			"publish": null,
			"default": "./src/i18n/*.ts"
		},
		"./Panel": "./src/entry-points/Panel.tsx",
		"./PanelStateless": "./src/entry-points/PanelStateless.tsx"
	},
	"atlaskit:src": "src/index.ts",
	"atlassian": {
		"team": "Bitbucket: CoreX",
		"website": {
			"name": "Panel"
		}
	},
	"dependencies": {
		"@atlaskit/afm-i18n-platform-bitbucket-panel": "root:*",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/theme": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"react-animate-height": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"@atlaskit/page": "workspace:^",
		"@atlassian/workbench": "workspace:^",
		"@testing-library/react": "root:*",
		"@testing-library/user-event": "root:*",
		"react": "^19.0.0",
		"react-intl": "root:*"
	},
	"sideEffects": [
		"*.compiled.css"
	],
	"platform-feature-flags": {}
}
