{
	"name": "@atlaskit/jql-editor-autocomplete-rest",
	"version": "4.6.0",
	"description": "Autocomplete REST API integration for the JQL Editor.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Jira Platform: Search Experience / Empanada",
		"website": {
			"name": "JQL Editor Autocomplete REST",
			"category": "JQL"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./state": "./src/state/index.ts",
		"./types": "./src/common/types.ts",
		"./use-autocomplete-provider": "./src/hooks/use-autocomplete-provider/index.ts"
	},
	"dependencies": {
		"@atlaskit/feature-gate-js-client": "workspace:^",
		"@atlaskit/jql-autocomplete": "workspace:^",
		"@atlaskit/jql-editor-common": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"lodash": "root:*",
		"react-magnetic-di": "root:*",
		"react-sweet-state": "root:*",
		"rxjs": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@atlaskit/docs": "workspace:^",
		"@atlassian/a11y-jest-testing": "workspace:^",
		"@atlassian/experiment-test-utils": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@testing-library/jest-dom": "root:*",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"react-dom": "root:*",
		"react-intl": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"enable-jql-membersof-autocomplete": {
			"type": "boolean"
		},
		"jira-descendants-of-team-jql-function": {
			"type": "boolean"
		},
		"orion-8274-cmdb-object-jql-values-resolver": {
			"type": "boolean"
		}
	},
	"platform-experiments": {
		"jira_filter_by_agent_and_agent_state": {
			"param": "isEnabled",
			"defaultValue": false
		}
	}
}
