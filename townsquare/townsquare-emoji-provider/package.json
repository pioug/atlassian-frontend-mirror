{
	"name": "@atlaskit/townsquare-emoji-provider",
	"version": "2.1.6",
	"description": "Townsquare emoji provider",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Townsquare"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/provider.js",
	"module": "dist/esm/provider.js",
	"module:es2019": "dist/es2019/provider.js",
	"types": "dist/types/provider.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/provider.ts",
	"exports": {
		".": "./src/provider.ts",
		"./project-icon": "./src/ProjectIcon.tsx"
	},
	"dependencies": {
		"@atlaskit/avatar": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/emoji": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/editor-common": "workspace:^",
		"@atlaskit/editor-core": "workspace:^",
		"@atlaskit/editor-plugins": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"react": "root:*"
	},
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	}
}
