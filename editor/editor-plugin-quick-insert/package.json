{
	"name": "@atlaskit/editor-plugin-quick-insert",
	"version": "30.0.4",
	"description": "Quick insert plugin for @atlaskit/editor-core",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"website": {
			"tags": [
				"platform-labs"
			]
		},
		"team": "Editor: Lego",
		"singleton": true
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./quick-insert-plugin": "./src/entry-points/quick-insert-plugin.tsx",
		"./registry-element-browser": "./src/entry-points/registry-element-browser.tsx",
		"./quick-insert-plugin-type": "./src/entry-points/quick-insert-plugin-type.ts",
		"./__internal/registered-menu/root": {
			"publish": null,
			"default": "./src/ui/registered-menu/QuickInsertMenuRoot.tsx"
		},
		"./__internal/registered-menu/menu-section": {
			"publish": null,
			"default": "./src/ui/registered-menu/QuickInsertMenuSection.tsx"
		},
		"./__internal/registered-menu/empty-state": {
			"publish": null,
			"default": "./src/ui/registered-menu/QuickInsertEmptyState.tsx"
		},
		"./__internal/registered-menu/typeahead-menu": {
			"publish": null,
			"default": "./src/ui/registered-menu/TypeAheadQuickInsertMenu.tsx"
		},
		"./registered-menu/model": "./src/ui/registered-menu/get-quick-insert-menu-model.ts",
		"./registered-menu/search-analytics": "./src/ui/registered-menu/useQuickInsertSearchAnalytics.ts"
	},
	"dependencies": {
		"@atlaskit/button": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/editor-plugin-analytics": "workspace:^",
		"@atlaskit/editor-plugin-connectivity": "workspace:^",
		"@atlaskit/editor-plugin-editor-viewmode": "workspace:^",
		"@atlaskit/editor-plugin-metrics": "workspace:^",
		"@atlaskit/editor-plugin-type-ahead": "workspace:^",
		"@atlaskit/editor-plugin-ui-control-registry": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/editor-tables": "workspace:^",
		"@atlaskit/editor-ui-control-model": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/menu": "workspace:^",
		"@atlaskit/modal-dialog": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/textfield": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/tooltip": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"@emotion/react": "root:*",
		"react-loosely-lazy": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-dom": "^18.2.0 || ^19.2.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"@atlassian/structured-docs-types": "workspace:^",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-intl": "root:*"
	},
	"platform-feature-flags": {
		"platform_editor_ease_of_use_metrics": {
			"type": "boolean"
		}
	}
}
