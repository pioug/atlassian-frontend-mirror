{
	"name": "@atlaskit/help-article",
	"version": "7.2.4",
	"description": "A cross-product help-article component",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./ArticleBody": "./src/entry-points/ArticleBody.tsx",
		"./HelpArticle": "./src/entry-points/HelpArticle.tsx",
		"./model/HelpArticle": "./src/entry-points/model-HelpArticle.ts"
	},
	"atlassian": {
		"team": "PACE PS2",
		"slack": {
			"channel": "#pace-ps2"
		},
		"website": {
			"name": "Help Article"
		}
	},
	"dependencies": {
		"@atlaskit/css-reset": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/renderer": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"@sentry/browser": "root:*",
		"lodash": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-test-renderer": "root:*"
	},
	"keywords": [
		"atlaskit",
		"react",
		"ui",
		"help"
	],
	"platform-feature-flags": {
		"asf-943-in-product-help-dark-mode": {
			"type": "boolean"
		},
		"nike_r19_render_unmount_help_article": {
			"type": "boolean"
		}
	}
}
