{
	"name": "@atlaskit/editor-plugin-mentions",
	"version": "20.0.4",
	"description": "Mentions plugin for @atlaskit/editor-core",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "Editor: AI",
		"singleton": true
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./anchored-popup": "./src/entry-points/anchored-popup.tsx",
		"./editor-commands": "./src/entry-points/editor-commands.ts",
		"./mention-node-data-provider": "./src/entry-points/mention-node-data-provider.ts",
		"./mentions-plugin": "./src/entry-points/mentions-plugin.tsx",
		"./mentions-plugin-type": "./src/entry-points/mentions-plugin-type.ts",
		"./types": "./src/entry-points/types.ts"
	},
	"dependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/editor-json-transformer": "workspace:^",
		"@atlaskit/editor-plugin-analytics": "workspace:^",
		"@atlaskit/editor-plugin-base": "workspace:^",
		"@atlaskit/editor-plugin-context-identifier": "workspace:^",
		"@atlaskit/editor-plugin-selection": "workspace:^",
		"@atlaskit/editor-plugin-type-ahead": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/feature-gate-js-client": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/insm": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/lozenge": "workspace:^",
		"@atlaskit/mention": "workspace:^",
		"@atlaskit/node-data-provider": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/popper": "workspace:^",
		"@atlaskit/popup": "workspace:^",
		"@atlaskit/portal": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/profilecard": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlaskit/teams-app-config": "workspace:^",
		"@atlaskit/theme": "workspace:^",
		"@atlaskit/tmp-editor-statsig": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/tooltip": "workspace:^",
		"@atlaskit/user-picker": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"bind-event-listener": "root:*",
		"focus-trap": "root:*",
		"react-loadable": "root:*",
		"uuid": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-dom": "^18.2.0 || ^19.2.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"@atlaskit/button": "workspace:^",
		"@atlaskit/editor-core": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-intl": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"team-mention-inline-smartlink": {
			"type": "boolean"
		},
		"platform_editor_mention_provider_via_plugin_config": {
			"type": "boolean"
		},
		"platform_editor_adf_with_localid": {
			"type": "boolean"
		},
		"inline_invite_from_mentions_kill_switch": {
			"type": "boolean"
		},
		"people-teams_migrate-user-profile-card": {
			"type": "boolean"
		},
		"platform_editor_agent_mentions_drop_one_fixes": {
			"type": "boolean"
		},
		"platform_editor_agent_card_close_on_chat": {
			"type": "boolean"
		},
		"platform_editor_mention_typeahead_profilecard": {
			"type": "boolean"
		},
		"platform_editor_typeahead_profilecard_scrollbar": {
			"type": "boolean"
		},
		"platform_editor_agent_mentions_invite_order": {
			"type": "boolean"
		},
		"platform_editor_agent_mentions_no_task_autofire": {
			"type": "boolean"
		},
		"platform_editor_agent_card_fixes": {
			"type": "boolean"
		}
	},
	"platform-experiments": {
		"platform_editor_mention_node_avatar": {
			"param": "isEnabled",
			"defaultValue": false
		}
	}
}
