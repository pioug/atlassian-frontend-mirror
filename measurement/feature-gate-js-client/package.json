{
	"name": "@atlaskit/feature-gate-js-client",
	"version": "8.0.0",
	"description": "Atlassians wrapper for the Statsig js-lite client.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "MEP: Switcheroo"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./compat/types": "./src/client/compat/types.ts",
		"./dynamic-config": "./src/client/compat/DynamicConfig.ts",
		"./eval-flags/eval-flags-unavailable-error": "./src/client/fetcher/EvalFlagsUnavailableError.ts",
		"./eval-flags/from-experiment-values-response": "./src/client/fetcher/evalFlags/fromExperimentValuesResponse.ts",
		"./eval-flags/get-eval-flags-status": "./src/client/fetcher/evalFlags/getEvalFlagsStatus.ts",
		"./eval-flags/has-no-usable-provider": "./src/client/fetcher/evalFlags/hasNoUsableProvider.ts",
		"./eval-flags/to-initialize-values": "./src/client/fetcher/evalFlags/toInitializeValues.ts",
		"./feature-gates": "./src/client/FeatureGates.ts",
		"./ffp/types": "./src/ffp/types.ts",
		"./file-persistent-override-adapter": {
			"publish": null,
			"default": "./src/client/FilePeristentOverrideAdapter.ts"
		},
		"./layer": "./src/client/compat/Layer.ts",
		"./persistent-override-adapter": {
			"publish": null,
			"default": "./src/client/PersistentOverrideAdapter.ts"
		},
		"./types": "./src/client/types.ts",
		"./version": "./src/client/version.ts"
	},
	"dependencies": {
		"@atlaskit/atlassian-context": "workspace:^",
		"@atlaskit/flag-client": "workspace:^",
		"@babel/runtime": "root:*",
		"@statsig/client-core": "root:*",
		"@statsig/js-client": "root:*",
		"eventemitter3": "root:*"
	},
	"devDependencies": {
		"@atlassiansox/analytics-web-client": "workspace:^",
		"jest-fetch-mock": "root:*"
	}
}
