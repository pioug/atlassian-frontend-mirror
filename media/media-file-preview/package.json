{
	"name": "@atlaskit/media-file-preview",
	"version": "2.0.0",
	"description": "A React Hook to fetch and render file previews. It's overloaded with fancy features like SSR, lazy loading, memory cache and local preview.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Media Exif",
		"website": {
			"name": "MediaFilePreview",
			"category": "Components"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./ensure-media-file-preview-error": "./src/ensureMediaFilePreviewError.ts",
		"./errors": "./src/errors.ts",
		"./image-load-error": "./src/ImageLoadError.ts",
		"./is-local-preview-error": "./src/isLocalPreviewError.ts",
		"./is-media-file-preview-error": "./src/isMediaFilePreviewError.ts",
		"./is-remote-preview-error": "./src/isRemotePreviewError.ts",
		"./is-unsupported-local-preview-error": "./src/isUnsupportedLocalPreviewError.ts",
		"./local-preview-error": "./src/LocalPreviewError.ts",
		"./media-file-preview-error": "./src/MediaFilePreviewError.ts",
		"./remote-preview-error": "./src/RemotePreviewError.ts",
		"./ssr-preview-error": "./src/SsrPreviewError.ts",
		"./types": "./src/types.ts",
		"./use-file-preview": "./src/useFilePreview.tsx",
		"./use-media-image": "./src/useMediaImage.tsx"
	},
	"dependencies": {
		"@atlaskit/media-client": "workspace:^",
		"@atlaskit/media-client-react": "workspace:^",
		"@atlaskit/media-common": "workspace:^",
		"@atlaskit/media-ui": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/react-ufo": "workspace:^",
		"@babel/runtime": "root:*",
		"lru_map": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/media-state": "workspace:^",
		"@atlaskit/media-test-data": "workspace:^",
		"@atlaskit/media-test-helpers": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlaskit/spinner": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@atlassian/a11y-jest-testing": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@atlassian/workbench": "workspace:^",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"react-dom": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"media-perf-uplift-mutation-fix": {
			"type": "boolean"
		},
		"media-perf-lazy-loading-optimisation": {
			"type": "boolean"
		},
		"platform_media_cross_client_copy_with_auth": {
			"type": "boolean"
		},
		"platform_media_ssr_data_seed": {
			"type": "boolean"
		}
	}
}
