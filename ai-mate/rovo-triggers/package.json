{
	"name": "@atlaskit/rovo-triggers",
	"version": "11.0.0",
	"description": "Provides various trigger events to drive Rovo Chat functionality, such as a publish-subscribe and URL parameter hooks",
	"author": "Atlassian Pty Ltd",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"website": {
			"tags": [
				"platform-labs"
			]
		},
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "AI Mate",
		"singleton": true
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./chat-context/types": "./src/common/utils/chat-context/types.tsx",
		"./chat-context": "./src/common/utils/chat-context/index.tsx",
		"./chat-entry-point": "./src/chat-entry-point.ts",
		"./extension-context-bridge/analytics": "./src/common/utils/extension-context-bridge/analytics.ts",
		"./extension-context-bridge/client": "./src/common/utils/extension-context-bridge/ExtensionContextBridgeClient.tsx",
		"./extension-context-bridge/constants": "./src/common/utils/extension-context-bridge/constants.ts",
		"./extension-context-bridge/host": "./src/common/utils/extension-context-bridge/ExtensionContextBridgeHost.tsx",
		"./extension-context-bridge/transport": "./src/common/utils/extension-context-bridge/transport.ts",
		"./jsm-journey-builder-types": "./src/common/types/jsm-journey-builder/index.ts",
		"./main": "./src/main.tsx",
		"./params": "./src/common/utils/params/index.ts",
		"./params-types": "./src/common/utils/params/types.ts",
		"./post-message-to-pubsub": "./src/common/utils/post-message-to-pubsub/index.tsx",
		"./solution-architect-types": "./src/common/types/solution-architect/index.ts",
		"./types": "./src/types.ts"
	},
	"dependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"bind-event-listener": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@atlassian/a11y-jest-testing": "workspace:^",
		"@atlassian/conversation-assistant-service-api": "workspace:^",
		"@atlassian/experiment-test-utils": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"react-dom": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"rovo_chat_replace_url_param_history": {
			"type": "boolean"
		}
	}
}
