{
	"extends": "../tsconfig",
	"compilerOptions": {
		"rootDir": "../src",
		"resolveJsonModule": true,
		"composite": false
	},
	"include": ["../src/**/*.ts", "../src/**/*.tsx"],
	"exclude": [
		"../src/**/__tests__/*",
		"../src/**/*.test.*",
		"../src/**/test.*",
		"../src/**/examples.*",
		"../src/**/examples/*",
		"../src/**/examples/**/*",
		"../src/**/*.stories.*",
		"../src/**/stories/*",
		"../src/**/stories/**/*"
	]
}
