{
	"name": "@atlaskit/editor-plugin-avatar-group",
	"version": "19.0.0",
	"description": "Avatar Group plugin for @atlaskit/editor-core.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "Editor: Collaboration",
		"website": {
			"name": "EditorPluginAvatarGroup",
			"category": "Components"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./avatarGroupPlugin": "./src/entry-points/avatarGroupPlugin.tsx",
		"./avatarGroupPluginType": "./src/entry-points/avatarGroupPluginType.ts"
	},
	"dependencies": {
		"@atlaskit/analytics-next": "workspace:^",
		"@atlaskit/avatar-group": "workspace:^",
		"@atlaskit/editor-plugin-analytics": "workspace:^",
		"@atlaskit/editor-plugin-collab-edit": "workspace:^",
		"@atlaskit/editor-plugin-feature-flags": "workspace:^",
		"@atlaskit/editor-plugin-primary-toolbar": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/editor-shared-styles": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@emotion/react": "root:*",
		"memoize-one": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"platform-feature-flags": {
		"platform_move_presence_agents": {
			"type": "boolean"
		}
	},
	"platform-experiments": {
		"platform_editor_invite_to_edit_button_aria_pressed": {
			"param": "isEnabled",
			"defaultValue": false
		}
	},
	"devDependencies": {
		"react": "^19.2.0",
		"react-intl": "root:*"
	}
}
