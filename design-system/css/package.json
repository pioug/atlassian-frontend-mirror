{
	"name": "@atlaskit/css",
	"version": "1.1.5",
	"description": "Style components backed by Atlassian Design System design tokens powered by Compiled CSS-in-JS.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
