{
	"name": "@atlaskit/css-reset",
	"version": "8.4.1",
	"description": "A base stylesheet for the Atlassian Design System.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/bundle.css",
	"module": "dist/bundle.css",
	"module:es2019": "dist/bundle.css",
	"types": "dist/types/index.d.ts",
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"team": "Design System Team",
		"website": {
			"name": "CSS reset",
			"category": "Libraries"
		}
	},
	"scripts": {
		"ak-postbuild": "mkdir -p dist && cp src/bundle.css dist/bundle.css && cp src/scrollbars.css dist/scrollbars.css && ABS_PATH=$(pwd) && ln -sf $ABS_PATH/dist/bundle.css dist/cjs/bundle.css && ln -sf $ABS_PATH/dist/bundle.css dist/esm/bundle.css && ln -sf $ABS_PATH/dist/bundle.css dist/es2019/bundle.css && cp $ABS_PATH/dist/scrollbars.css $ABS_PATH/dist/cjs/scrollbars.css && cp $ABS_PATH/dist/scrollbars.css $ABS_PATH/dist/esm/scrollbars.css && cp $ABS_PATH/dist/scrollbars.css $ABS_PATH/dist/es2019/scrollbars.css",
		"build-css": "run-ts build/js-to-css.tsx"
	},
	"dependencies": {
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/formatting": "workspace:^",
		"@af/root-path": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlassian/ts-loader": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"mkdirp": "root:*",
		"react": "^19.0.0"
	},
	"keywords": [
		"atlaskit",
		"css",
		"ui"
	],
	"exports": {
		".": "./src/index.tsx",
		"./styles": "./src/index.tsx",
		"./base": "./src/base.tsx",
		"./browser-fixes": "./src/browser-fixes.tsx",
		"./bundle.css": "./src/bundle.css",
		"./scrollbars.css": "./src/scrollbars.css",
		"./reset": "./src/reset.tsx",
		"./tables": "./src/tables.tsx",
		"./utils": "./src/utils.tsx"
	},
	"homepage": "https://atlassian.design/components/css-reset",
	"platform-feature-flags": {}
}
