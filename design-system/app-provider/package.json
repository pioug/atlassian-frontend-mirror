{
	"name": "@atlaskit/app-provider",
	"version": "5.5.1",
	"description": "A top level provider for the Design System.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "App provider",
			"category": "Tooling",
			"status": {
				"type": "beta"
			}
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"exports": {
		".": "./src/index.tsx",
		"./app-provider": "./src/app-provider.tsx",
		"./scrollbar-harmonisation": "./src/scrollbar-harmonisation/scrollbar-harmonisation.tsx",
		"./use-scrollbar-harmonisation": "./src/scrollbar-harmonisation/use-scrollbar-harmonisation.tsx",
		"./use-color-mode-for-migration": "./src/theme-provider/hooks/use-color-mode-for-migration.tsx",
		"./use-color-mode": "./src/theme-provider/hooks/use-color-mode.tsx",
		"./use-is-inside-theme-provider": "./src/theme-provider/hooks/use-is-inside-theme-provider.tsx",
		"./use-set-color-mode": "./src/theme-provider/hooks/use-set-color-mode.tsx",
		"./use-set-theme": "./src/theme-provider/hooks/use-set-theme.tsx",
		"./use-theme": "./src/theme-provider/hooks/use-theme.tsx",
		"./theme": "./src/theme-provider/context/theme.tsx",
		"./theme-provider": "./src/theme-provider/index.tsx",
		"./router-link-provider": "./src/router-link-provider/index.tsx",
		"./use-router-link": "./src/router-link-provider/hooks/use-router-link.tsx"
	},
	"dependencies": {
		"@atlaskit/browser-apis": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"bind-event-listener": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/code": "workspace:^",
		"@atlaskit/dropdown-menu": "workspace:^",
		"@atlaskit/form": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/select": "workspace:^",
		"@atlaskit/tile": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"react": "^19.0.0",
		"react-dom": "^19.2.0",
		"react-resource-router": "root:*"
	},
	"platform-feature-flags": {
		"platform_dst_scrollbar_harmonisation": {
			"type": "boolean"
		},
		"platform_dst_scrollbar_harmonisation_transparent": {
			"type": "boolean"
		},
		"platform_increased-contrast-themes": {
			"type": "boolean"
		}
	},
	"homepage": "https://atlassian.design/components/app-provider"
}
