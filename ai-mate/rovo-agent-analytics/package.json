{
	"name": "@atlaskit/rovo-agent-analytics",
	"version": "6.4.0",
	"description": "Rovo Agents analytics",
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Rovo Agents",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "RovoAgentAnalytics",
			"category": "Layout and structure"
		}
	},
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"atlaskit:src": "src/index.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"exports": {
		"./actions/groups/create-flow": "./src/actions/groups/create-flow.ts",
		"./actions": "./src/actions/index.tsx",
		"./create": "./src/create/index.tsx",
		".": "./src/index.ts"
	},
	"dependencies": {
		"@atlaskit/analytics-listeners": "workspace:^",
		"@atlaskit/analytics-next": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"react-dom": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	}
}
