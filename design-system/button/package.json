{
	"name": "@atlaskit/button",
	"version": "25.3.4",
	"description": "A button triggers an event or action. They let users know what will happen next.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Button",
			"category": "Forms and input",
			"subPages": [
				{
					"title": "Icon button",
					"id": "icon-button",
					"sortKey": 1
				},
				{
					"title": "Link button",
					"id": "link-button",
					"sortKey": 2
				},
				{
					"title": "Link icon button",
					"id": "link-icon-button",
					"sortKey": 3
				},
				{
					"title": "Split button",
					"id": "split-button",
					"sortKey": 4
				},
				{
					"title": "Button group",
					"id": "button-group",
					"sortKey": 5
				},
				{
					"title": "Button (legacy)",
					"id": "button-legacy",
					"status": {
						"type": "intent-to-deprecate",
						"description": "Legacy buttons will soon be deprecated. Please use the new [button](/components/button), [icon button](/components/button/icon-button), [link button](/components/button/link-button), or [link icon button](/components/button/link-icon-button). Migrate from legacy buttons using our codemod.",
						"actions": [
							{
								"text": "View the migration guide",
								"href": "/components/button/button-legacy/migration-guide"
							}
						]
					},
					"sortKey": 6
				}
			]
		}
	},
	"exports": {
		".": "./src/index.tsx",
		"./button": "./src/old-button/button.tsx",
		"./button-group": "./src/containers/button-group.tsx",
		"./containers/button-group": "./src/containers/button-group.tsx",
		"./custom-theme-button/custom-theme-button": "./src/old-button/custom-theme-button/custom-theme-button.tsx",
		"./custom-theme-button": "./src/entry-points/custom-theme-button.tsx",
		"./custom-theme-button-types": "./src/old-button/custom-theme-button/custom-theme-button-types.tsx",
		"./default/button": "./src/new-button/variants/default/button.tsx",
		"./divider": "./src/new-button/containers/split-button/divider.tsx",
		"./icon/button": "./src/new-button/variants/icon/button.tsx",
		"./icon/link": "./src/new-button/variants/icon/link.tsx",
		"./link": "./src/new-button/variants/default/link.tsx",
		"./loading-button": "./src/old-button/loading-button.tsx",
		"./new": "./src/entry-points/new.tsx",
		"./old-button/types": "./src/old-button/types.tsx",
		"./split-button/split-button": "./src/new-button/containers/split-button/split-button.tsx",
		"./split-button": "./src/entry-points/split-button.tsx",
		"./split-button-container": "./src/new-button/containers/split-button/split-button-container.tsx",
		"./split-button-with-slots": "./src/new-button/containers/split-button/split-button-with-slots.tsx",
		"./standard-button": "./src/old-button/button.tsx",
		"./theme": "./src/old-button/custom-theme-button/theme.tsx",
		"./types": "./src/entry-points/types.tsx",
		"./variants/types": "./src/new-button/variants/types.tsx"
	},
	"dependencies": {
		"@atlaskit/analytics-next": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/ds-lib": "workspace:^",
		"@atlaskit/focus-ring": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/interaction-context": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/spinner": "workspace:^",
		"@atlaskit/theme": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/tooltip": "workspace:^",
		"@atlaskit/visually-hidden": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"@emotion/react": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/app-provider": "workspace:^",
		"@atlaskit/checkbox": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/dropdown-menu": "workspace:^",
		"@atlaskit/form": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/logo": "workspace:^",
		"@atlaskit/modal-dialog": "workspace:^",
		"@atlaskit/range": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlaskit/select": "workspace:^",
		"@atlaskit/toggle": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"@testing-library/user-event": "root:*",
		"ast-types": "root:*",
		"jscodeshift": "root:*",
		"lodash": "root:*",
		"react": "^19.0.0",
		"react-dom": "^19.2.0"
	},
	"homepage": "https://atlassian.design/components/button/",
	"platform-feature-flags": {
		"platform_dst_button_chevron_sizing": {
			"type": "boolean"
		},
		"platform-dst-motion-uplift-button": {
			"type": "boolean"
		},
		"platform-dst-legacy-button-anchor-text-color": {
			"type": "boolean"
		},
		"platform-dst-tokens-finesse": {
			"type": "boolean"
		}
	}
}
