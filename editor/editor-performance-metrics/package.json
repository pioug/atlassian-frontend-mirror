{
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Editor: Lego",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "EditorPerformanceMetrics",
			"category": "Components"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./editorPerformanceObserver": "./src/entry-points/editorPerformanceObserver.ts",
		"./global": "./src/entry-points/global.ts",
		"./metrics/editorPerformanceMetrics": "./src/entry-points/metrics-editorPerformanceMetrics.ts",
		"./metrics": "./src/metrics.ts",
		"./page-complexity-score": "./src/entry-points/page-complexity-score.ts",
		"./react": "./src/entry-points/react.tsx",
		"./timeline/timeline": "./src/entry-points/timeline-timeline.ts",
		"./timeline/timelineInterfaces": "./src/entry-points/timeline-timelineInterfaces.ts",
		"./timeline/timelineTypes": "./src/entry-points/timeline-timelineTypes.ts",
		"./timeline": "./src/timeline.ts",
		"./user-latency": "./src/entry-points/user-latency.ts"
	},
	"dependencies": {
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"bind-event-listener": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.2.0"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@atlaskit/checkbox": "workspace:^",
		"@atlaskit/textarea": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"wait-for-expect": "root:*"
	},
	"scripts": {
		"build-and-copy-page-score": "npx esbuild ./src/page-complexity-score/index.ts --bundle --platform=neutral --target=es2022 --format=iife --global-name=pageTreeScore | pbcopy"
	},
	"name": "@atlaskit/editor-performance-metrics",
	"version": "4.0.0",
	"description": "Experimental code to track Editor Full Page performance on some particular scenarios",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	}
}
