{
	"name": "@atlaskit/drawer",
	"version": "14.3.3",
	"description": "A drawer is a panel that slides in from the left side of the screen.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"exports": {
		".": "./src/index.tsx",
		"./drawer": "./src/drawer.tsx",
		"./drawer-close-button": "./src/drawer-panel/drawer-close-button.tsx",
		"./drawer-content": "./src/drawer-panel/drawer-content.tsx",
		"./drawer-sidebar": "./src/drawer-panel/drawer-sidebar.tsx",
		"./types": "./src/types.tsx"
	},
	"platform-feature-flags": {
		"platform-dst-top-layer": {
			"type": "boolean"
		}
	},
	"homepage": "https://atlassian.design/components/drawer",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "Drawer",
			"category": "Overlays and layering",
			"status": {
				"type": "intent-to-deprecate",
				"description": "We are planning on deprecating Drawer. Please use [Modal](/components/modal-dialog) instead. Drawer should not be used with our new [Navigation system](/components/navigation-system)"
			}
		}
	},
	"dependencies": {
		"@atlaskit/analytics-next": "workspace:^",
		"@atlaskit/blanket": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/ds-lib": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/layering": "workspace:^",
		"@atlaskit/motion": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/portal": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/theme": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/top-layer": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"bind-event-listener": "root:*",
		"exenv": "root:*",
		"react-focus-lock": "root:*",
		"react-scrolllock": "root:*",
		"tiny-invariant": "root:*",
		"use-callback-ref": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/code": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/dropdown-menu": "workspace:^",
		"@atlaskit/form": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/inline-message": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/menu": "workspace:^",
		"@atlaskit/modal-dialog": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"@testing-library/user-event": "root:*",
		"@types/exenv": "root:*",
		"lorem-ipsum": "root:*",
		"react": "^19.0.0",
		"react-dom": "root:*"
	}
}
