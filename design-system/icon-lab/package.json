{
	"name": "@atlaskit/icon-lab",
	"version": "7.9.1",
	"description": "An icon package for public icon contributions",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"productPushConsumption": [
			"jira"
		],
		"releaseModel": "continuous",
		"website": {
			"name": "Icon",
			"category": "Images and icons"
		}
	},
	"scripts": {
		"build-glyphs": "tsx ./build/index.tsx"
	},
	"dependencies": {
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/icon-build-process": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/code": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/modal-dialog": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/textfield": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/tooltip": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@compiled/react": "root:*",
		"@testing-library/react": "root:*",
		"fs-extra": "root:*",
		"pkg-dir": "root:*",
		"react": "^19.0.0",
		"react-dom": "root:*",
		"tsx": "root:*"
	},
	"keywords": [
		"atlaskit",
		"ui"
	],
	"exports": {
		"./deprecated-map": "./src/entry-points/deprecated-map.tsx",
		"./metadata": "./src/entry-points/metadata.tsx",
		"./core": "./core",
		"./core/*": {
			"types": "./core/*.d.ts",
			"default": "./core/*.js"
		},
		".": "./src/index.tsx"
	},
	"homepage": "https://atlaskit.atlassian.com/packages/design-system/icon-lab"
}
