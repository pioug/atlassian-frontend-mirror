		"./types": "./src/entry-points/types.ts",
		"./commands": "./src/entry-points/commands.ts"
	},
	"dependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/editor-plugin-analytics": "workspace:^",
		"@atlaskit/editor-plugin-connectivity": "workspace:^",
		"@atlaskit/editor-plugin-context-panel": "workspace:^",
		"@atlaskit/editor-plugin-metrics": "workspace:^",
		"@atlaskit/editor-plugin-ui-control-registry": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/editor-shared-styles": "workspace:^",
		"@atlaskit/editor-ui-control-model": "workspace:^",
		"@atlaskit/feature-gate-js-client": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/insm": "workspace:^",
		"@atlaskit/mention": "workspace:^",
		"@atlaskit/menu": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/prosemirror-history": "workspace:^",
		"@atlaskit/prosemirror-input-rules": "workspace:^",
		"@atlaskit/tmp-editor-statsig": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/visually-hidden": "workspace:^",
		"@babel/runtime": "root:*",
		"@emotion/react": "root:*",
		"lodash": "root:*",
		"raf-schd": "root:*",
		"react-virtualized": "root:*",
		"uuid": "root:*",
		"w3c-keyname": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-dom": "^18.2.0 || ^19.2.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"@atlassian/testing-library": "workspace:^",
		"@testing-library/react": "root:*",
		"@types/react-virtualized": "root:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-intl": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"editor-disable-feature": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform_editor_ease_of_use_metrics": {
			"type": "boolean"
		},
		"platform_editor_agent_mentions_drop_one_fixes": {
			"type": "boolean"
		},
		"platform_editor_mention_typeahead_profilecard": {
			"type": "boolean"
		}
