{
	"name": "@atlaskit/ads-cli",
	"version": "0.11.0",
	"description": "An npx-runnable command-line tool to query Atlassian Design System (ADS) structured content — components, tokens, icons, and guidelines — from the terminal.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"homepage": "https://atlaskit.atlassian.com/packages/design-system/ads-cli",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "Design System Team"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "index.js",
	"types": "dist/types/cli.d.ts",
	"atlaskit:src": "src/cli.tsx",
	"bin": "./bin/ads-cli.js",
	"scripts": {
		"start": "./bin/ads-cli.js",
		"build:atlas": "esbuild src/atlas-cli.tsx --bundle --outfile=build/atlas/ads-cli.js --format=cjs --platform=node --target=node18",
		"package:atlas:darwin-amd64": "pkg --public --public-packages '*' --compress GZip --target node18-macos-x64 --output build/atlas/ads-darwin-amd64 build/atlas/ads-cli.js",
		"package:atlas:darwin-arm64": "pkg --public --public-packages '*' --compress GZip --target node18-macos-arm64 --output build/atlas/ads-darwin-arm64 build/atlas/ads-cli.js",
		"package:atlas:linux-amd64": "pkg --public --public-packages '*' --compress GZip --target node18-linux-x64 --output build/atlas/ads-linux-amd64 build/atlas/ads-cli.js",
		"package:atlas:linux-arm64": "pkg --public --public-packages '*' --compress GZip --target node18-linux-arm64 --output build/atlas/ads-linux-arm64 build/atlas/ads-cli.js",
		"package:atlas:windows-amd64": "pkg --public --public-packages '*' --compress GZip --target node18-win-x64 --output build/atlas/ads-windows-amd64.exe build/atlas/ads-cli.js",
		"package:atlas": "afm run build:atlas && afm run package:atlas:darwin-amd64 && afm run package:atlas:darwin-arm64 && afm run package:atlas:linux-amd64 && afm run package:atlas:linux-arm64 && afm run package:atlas:windows-amd64",
		"release:atlas:fetch-manifest": "bash scripts/atlas/fetch-manifest.sh",
		"release:atlas:prepare": "bash scripts/atlas/prepare-release.sh",
		"release:atlas:upload": "bash scripts/atlas/upload-release.sh",
		"release:atlas:promote": "bash scripts/atlas/promote-stable.sh"
	},
	"exports": {
		".": {
			"types": "./src/cli.tsx",
			"publish": "./src/cli.tsx",
			"default": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@atlaskit/ads-mcp": "workspace:^",
		"@atlaskit/cli-output": "workspace:^",
		"@babel/runtime": "root:*",
		"chalk": "root:*"
	},
	"devDependencies": {
		"@atlassian/ts-loader": "workspace:^",
		"esbuild": "root:*",
		"pkg": "root:*"
	}
}
