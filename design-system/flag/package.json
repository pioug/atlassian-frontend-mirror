{
	"name": "@atlaskit/flag",
	"version": "18.5.4",
	"description": "A flag is used for confirmations, alerts, and acknowledgments that require minimal user interaction, often displayed using a flag group.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Flag",
			"category": "Messaging"
		}
	},
	"exports": {
		".": "./src/index.tsx",
		"./action-text-color": "./src/action-text-color.tsx",
		"./auto-dismiss-flag": "./src/auto-dismiss-flag.tsx",
		"./constants": "./src/constants.tsx",
		"./flag": "./src/flag.tsx",
		"./flag-actions": "./src/flag-actions.tsx",
		"./flag-background-color": "./src/flag-background-color.tsx",
		"./flag-context": "./src/flag-context.tsx",
		"./flag-group": "./src/flag-group.tsx",
		"./flag-group-context": "./src/internal/flag-group-context.tsx",
		"./flag-icon-color": "./src/flag-icon-color.tsx",
		"./flag-icon-glyph": "./src/flag-icon-glyph.tsx",
		"./flag-provider": "./src/flag-provider.tsx",
		"./flag-text-color": "./src/flag-text-color.tsx",
		"./flag-text-color-token": "./src/flag-text-color-token.tsx",
		"./flags-provider": "./src/flags-provider.tsx",
		"./theme": "./src/theme.tsx",
		"./types": "./src/types.tsx",
		"./use-flag-group": "./src/internal/use-flag-group.tsx",
		"./use-flags": "./src/use-flags.tsx",
		"./with-flags-provider": "./src/with-flags-provider.tsx"
	},
	"dependencies": {
		"@atlaskit/analytics-next": "workspace:^",
		"@atlaskit/browser-apis": "workspace:^",
		"@atlaskit/button": "workspace:^",
		"@atlaskit/css": "workspace:^",
		"@atlaskit/ds-lib": "workspace:^",
		"@atlaskit/heading": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/motion": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/portal": "workspace:^",
		"@atlaskit/primitives": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/theme": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@atlaskit/top-layer": "workspace:^",
		"@atlaskit/visually-hidden": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"bind-event-listener": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/drawer": "workspace:^",
		"@atlaskit/link": "workspace:^",
		"@atlaskit/modal-dialog": "workspace:^",
		"@atlaskit/radio": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlaskit/spinner": "workspace:^",
		"@atlaskit/textfield": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "root:*",
		"@testing-library/user-event": "root:*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"keywords": [
		"atlaskit",
		"react",
		"ui"
	],
	"homepage": "https://atlassian.design/components/flag/",
	"platform-feature-flags": {
		"platform-dst-flag-collapse-animation-fix": {
			"type": "boolean"
		},
		"platform-dst-motion-uplift": {
			"type": "boolean"
		},
		"platform-dst-top-layer": {
			"type": "boolean"
		},
		"platform_dst_flag_keyboard_dismiss": {
			"type": "boolean"
		},
		"platform_dst_flag_action_padding_fix": {
			"type": "boolean"
		},
		"cc_mohiti_flag_anchoring": {
			"type": "boolean"
		}
	}
}
