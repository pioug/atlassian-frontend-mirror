{
	"name": "@atlaskit/collab-provider",
	"version": "27.0.11",
	"description": "A provider for collaborative editing.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"atlassian": {
		"team": "Editor: Collaboration"
	},
	"exports": {
		".": "./src/index.ts",
		"./provider": "./src/entry-points/provider.ts",
		"./sleep-detector": "./src/entry-points/sleep-detector.ts",
		"./socket-io-provider": "./src/entry-points/socket-io-provider.ts",
		"./types": "./src/entry-points/types.ts",
		"./version-wrapper": "./src/entry-points/version-wrapper.ts"
	},
	"dependencies": {
		"@atlaskit/adf-utils": "workspace:^",
		"@atlaskit/analytics-gas-types": "workspace:^",
		"@atlaskit/analytics-listeners": "workspace:^",
		"@atlaskit/anonymous-assets": "workspace:^",
		"@atlaskit/atlassian-context": "workspace:^",
		"@atlaskit/editor-json-transformer": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/feature-gate-js-client": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/prosemirror-collab": "workspace:^",
		"@atlaskit/react-ufo": "workspace:^",
		"@atlaskit/tmp-editor-statsig": "workspace:^",
		"@atlaskit/ufo": "workspace:^",
		"@atlaskit/util-service-support": "workspace:^",
		"@babel/runtime": "root:*",
		"bind-event-listener": "root:*",
		"eventemitter2": "root:*",
		"lodash": "root:*",
		"prosemirror-changeset": "root:*",
		"socket.io-client": "root:*",
		"uuid": "root:*"
	},
	"devDependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/editor-test-helpers": "workspace:^",
		"@atlassian/a11y-jest-testing": "workspace:^",
		"@atlassian/experiment-test-utils": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^"
	},
	"platform-feature-flags": {
		"confluence_ncs_step_diffing_version_history": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform_move_presence_agents": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform_editor_agentic_step_attribution": {
			"type": "boolean"
		},
		"platform-editor-presence-websocket-only": {
			"type": "boolean"
		},
		"collab_edit_via_websocket_only_for_gcp": {
			"type": "boolean"
		},
		"platform_editor_blocked_document_ux": {
			"type": "boolean"
		}
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^"
	}
}
