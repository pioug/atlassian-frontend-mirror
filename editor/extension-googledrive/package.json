{
	"name": "@atlaskit/editor-extension-googledrive",
	"version": "20.0.0",
	"description": "An Atlassian editor extension to add a native Google Drive picker",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"url": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo"
	},
	"author": "Atlassian",
	"license": "Apache-2.0",
	"atlaskit:src": "src/index.ts",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"main": "dist/cjs/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "trello-ecosystem"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"dependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/adf-utils": "workspace:^",
		"@atlaskit/docs": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@atlaskit/section-message": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"@types/gapi": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-dom": "^18.2.0 || ^19.2.0"
	},
	"devDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
