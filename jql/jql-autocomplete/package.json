{
	"name": "@atlaskit/jql-autocomplete",
	"version": "3.1.0",
	"description": "JQL autocomplete engine",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "Jira Platform: Search Experience / Empanada",
		"website": {
			"name": "JQL Autocomplete",
			"category": "JQL"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./base-autocomplete/types": "./src/base-autocomplete/types.ts",
		"./constants": "./src/jql-autocomplete/constants.ts",
		"./jql-autocomplete/types": "./src/jql-autocomplete/types.ts",
		"./jql-autocomplete": "./src/jql-autocomplete/index.ts",
		"./types": "./src/common/types.ts"
	},
	"dependencies": {
		"@atlaskit/jql-parser": "workspace:^",
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@babel/runtime": "root:*",
		"antlr4-c3": "root:*",
		"antlr4ts": "root:*",
		"assert": "root:*",
		"util": "root:*"
	},
	"devDependencies": {
		"@atlaskit/docs": "workspace:^",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
		"enable-jql-membersof-autocomplete": {
			"type": "boolean"
		}
	}
}
