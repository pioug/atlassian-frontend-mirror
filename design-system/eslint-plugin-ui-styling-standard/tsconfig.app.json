{
	"extends": "../../../tsconfig.node.json",
	"include": [
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"**/docs/**/*",
		"**/__tests__/**/*",
		"**/vr-tests/**/*",
		"**/*.test.*",
		"**/test.*",
		"**/test-*",
		"**/examples.ts",
		"**/examples.tsx",
		"**/examples/*.ts",
		"**/examples/*.tsx",
		"**/examples/**/*.ts",
		"**/examples/**/*.tsx",
		"**/storybook/**/*",
		"**/constellation/**/*",
		".storybook/*",
		"./__fixtures__/**/*",
		"./__generated__/**/*",
		"./mocks/**/*",
		"./__mocks__/**/*",
		"**/mock.*",
		"**/codemods/**/*.ts",
		"**/codemods/**/*.tsx",
		"./**/__fixtures__/**/*.json",
		"**/stories.ts",
		"**/stories.tsx",
		"**/stories/*.ts",
		"**/stories/*.tsx",
		"**/stories/**/*.ts",
		"**/stories/**/*.tsx",
		"./scripts/*.tsx"
	],
	"exclude": [],
	"compilerOptions": {
		"lib": [
			"ES2021.String",
			"ES2022"
		],
		"composite": true,
		"outDir": "../../../tsDist/@atlaskit__eslint-plugin-ui-styling-standard/app",
		"isolatedDeclarations": true
	},
	"references": [
		{
			"path": "../ds-lib/tsconfig.app.json"
		},
		{
			"path": "../eslint-plugin/tsconfig.app.json"
		},
		{
			"path": "../eslint-utils/tsconfig.app.json"
		},
		{
			"path": "../codegen/tsconfig.app.json"
		}
	]
}
