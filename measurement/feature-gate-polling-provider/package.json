{
	"name": "@atlaskit/feature-gate-polling-provider",
	"version": "2.0.1",
	"description": "Provider that has caching and polling support when getting values from feature-flag-service. To be used with the @atlaskit/feature-gate-js-client",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"team": "MEP: Switcheroo"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./provider": "./src/entry-points/provider.ts",
		"./types": "./src/entry-points/types.ts"
	},
	"dependencies": {
		"@atlaskit/feature-gate-fetcher": "workspace:^",
		"@atlaskit/feature-gate-js-client": "workspace:^",
		"@babel/runtime": "root:*",
		"bind-event-listener": "root:*"
	}
}
