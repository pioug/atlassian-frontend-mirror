			"type": "boolean"
		}
	},
	"exports": {
		".": "./src/index.ts",
		"./placeholder-text-plugin": "./src/entry-points/placeholder-text-plugin.tsx",
		"./placeholder-text-plugin-type": "./src/entry-points/placeholder-text-plugin-type.ts"
