				"desktop-firefox",
				"desktop-webkit"
			]
		}
	},
	"dependencies": {
		"@atlaskit/adf-schema": "workspace:^",
		"@atlaskit/editor-plugin-analytics": "workspace:^",
		"@atlaskit/editor-plugin-type-ahead": "workspace:^",
		"@atlaskit/editor-plugin-ui-control-registry": "workspace:^",
		"@atlaskit/editor-prosemirror": "workspace:^",
		"@atlaskit/icon": "workspace:^",
		"@atlaskit/platform-feature-experiments": "workspace:^",
		"@atlaskit/tokens": "workspace:^",
		"@babel/runtime": "root:*",
		"@emotion/react": "root:*"
	},
	"peerDependencies": {
		"@atlaskit/editor-common": "workspace:^",
		"react": "^18.2.0 || ^19.2.0",
		"react-dom": "^18.2.0 || ^19.2.0",
		"react-intl": "^5.25.1 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"@testing-library/react": "root:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-intl": "root:*",
		"wait-for-expect": "root:*"
	},
	"platform-feature-flags": {
