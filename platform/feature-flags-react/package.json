{
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Jlove-Makkuro",
		"website": {
			"name": "PlatformFeatureFlagsReact",
			"category": "Layout and structure"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@atlassian/feature-flags-test-utils": "workspace:^",
		"@atlassian/testing-library": "workspace:^",
		"@testing-library/react": "root:*",
		"react": "root:*",
		"react-dom": "root:*"
	},
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./component-with-condition": "./src/utils/component-with-condition/index.tsx",
		"./component-with-fg": "./src/utils/component-with-fg/index.ts",
		"./conditional-hooks-factory/conditional-hooks-factory": "./src/utils/conditional-hooks-factory/conditionalHooksFactory.ts",
		"./do-not-use-this-in-production-ever-reset-conditional-hooks-factory-cache": "./src/utils/conditional-hooks-factory/DO_NOT_USE_THIS_IN_PRODUCTION_EVER_resetConditionalHooksFactoryCache.ts",
		"./function-union-with-condition": "./src/utils/function-with-condition/functionUnionWithCondition.ts",
		"./function-with-condition/function-with-condition": "./src/utils/function-with-condition/functionWithCondition.ts",
		"./function-with-fg": "./src/utils/function-with-fg/index.ts",
		"./function-with-condition": "./src/entry-points/function-with-condition.ts",
		"./conditional-hooks-factory": "./src/entry-points/conditional-hooks-factory.ts"
	},
	"dependencies": {
		"@atlaskit/platform-feature-flags": "workspace:^",
		"@atlaskit/react-compiler-gating": "workspace:^",
		"@babel/runtime": "root:*",
		"@compiled/react": "root:*",
		"react-magnetic-di": "root:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"name": "@atlaskit/platform-feature-flags-react",
	"version": "1.2.0",
	"description": "utility library for working with feature flags in react",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	}
}
